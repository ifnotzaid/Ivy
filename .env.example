# Flask session signing key. Generate your own for local/prod use.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Required for Gemini-powered style restyling and practice generation.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which Gemini model to use (default gemini-2.5-flash).
# The free tier gives gemini-2.5-flash only 20 requests a day; a "lite" model
# such as gemini-3.5-flash-lite has its own, separate daily quota.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: required only for Google Cloud Text-to-Speech narration.
# Use an absolute path to a local service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\google-service-account.json

# Optional Google Cloud TTS voice style. The app defaults to Aoede.
GOOGLE_TTS_VOICE_STYLE=Aoede
